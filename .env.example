# Copy to .env for local development. Never commit real secrets (ADR-0019: SOPS for deployed envs).
NODE_ENV=development
LOG_LEVEL=debug

DATABASE_URL=postgres://fp:fp@localhost:54330/fp
REDIS_URL=redis://localhost:6390

# Payload
PAYLOAD_SECRET=dev-only-change-me-0123456789abcdef
NEXT_PUBLIC_SERVER_URL=http://localhost:8080

# Secret encryption keyring (ADR-0012): "id:<base64 32 bytes>[,id2:...]"
SECRETS_KEYRING=k1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SECRETS_CURRENT_KEY=k1

# Collector
COLLECTOR_PORT=3100
COLLECTOR_COOKIE_DOMAIN=
COLLECTOR_SITE_KEYS=dev-site:1

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Email (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1026

# Signed email links (unsubscribe, double opt-in). >= 32 chars.
EMAIL_LINK_SECRET=dev-only-email-link-secret-0123456789abcdef
# Shared token for provider bounce/complaint webhooks (?token=...)
EMAIL_WEBHOOK_TOKEN=dev-only-webhook-token

# Cloudflare Turnstile test keys (always pass). Replace in staging/production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Consent test matrix: honour `x-fp-debug-geo: DE` (never in production)
ALLOW_DEBUG_GEO=true

# Media storage (SeaweedFS S3 in dev). Leave S3_BUCKET empty to use local disk.
S3_BUCKET=
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev

# Worker
WORKER_ROLES=ingest,relay,destinations,email,scheduler
PUBLIC_BASE_URL=http://localhost:8080
# Dev/e2e only: send platform APIs to the mock server (pnpm --filter @fp/mock-destinations dev)
META_BASE_URL=http://localhost:4010/meta
TIKTOK_BASE_URL=http://localhost:4010/tiktok
SNAP_BASE_URL=http://localhost:4010/snap
ALLOW_PRIVATE_WEBHOOKS=true
MOCK_DESTINATIONS_URL=http://localhost:4010
