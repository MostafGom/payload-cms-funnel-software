# Production edge (ADR-0005, ADR-0015). Cloudflare (WAF, Turnstile) sits in front; Caddy issues
# certificates on demand for every host in the Domains collection.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		# Only hosts registered and active in the CMS get a certificate.
		ask http://web:3000/api/v1/domains/allowed
	}
	servers {
		# Trust Cloudflare's edge for client IPs (CLIENT_IP_HEADER=cf-connecting-ip).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

https:// {
	tls {
		on_demand
	}
	import security_headers
	encode zstd gzip

	# Same-origin collector (first-party cookies, resists ad-blockers).
	handle /_t/* {
		reverse_proxy collector:3100 {
			lb_policy round_robin
			health_uri /_t/healthz
		}
	}
	# Internal admin API used by the deliveries view stays behind the admin login; the CMS admin
	# itself should additionally be protected by Cloudflare Access on the primary domain.
	handle {
		reverse_proxy web:3000 {
			lb_policy round_robin
			health_uri /api/healthz
		}
	}
}
