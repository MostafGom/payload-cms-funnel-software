# App node runtime config. Store encrypted with SOPS (infra/env/app.env.sops); decrypt to /etc/fp/app.env on deploy.
NODE_ENV=production
LOG_LEVEL=info
DATABASE_URL=postgres://fp:CHANGE@10.0.0.2:5432/fp
REDIS_URL=redis://:CHANGE@10.0.0.2:6379
PAYLOAD_SECRET=CHANGE-64-random-chars
NEXT_PUBLIC_SERVER_URL=https://brand.com
PUBLIC_BASE_URL=https://brand.com
SECRETS_KEYRING=k1:CHANGE_base64_32_bytes
SECRETS_CURRENT_KEY=k1
EMAIL_LINK_SECRET=CHANGE-48-random-chars
EMAIL_WEBHOOK_TOKEN=CHANGE
TURNSTILE_SECRET_KEY=CHANGE
NEXT_PUBLIC_TURNSTILE_SITE_KEY=CHANGE
COLLECTOR_SITE_KEYS=brand-site:1
COLLECTOR_COOKIE_DOMAIN=.brand.com
CONSENT_OVERRIDES=
ALLOW_DEBUG_GEO=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://10.0.0.2:4318
S3_BUCKET=fp-media
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=CHANGE
S3_SECRET_ACCESS_KEY=CHANGE
SMTP_HOST=
SMTP_PORT=587
